# adventofcode.com → dev tools → Application → Cookies → `session`. Expires after about a month.
AOC_SESSION=your_session_cookie_here

# AoC's automation guidelines ask for contact info in the User-Agent. Default: this repo's URL.
# AOC_USER_AGENT=github.com/you/your-repo (aoc cli)

# JEV language picks (or macOS keychain service "openrouter-api-key"). Without it: a random unused language.
# OPENROUTER_API_KEY=

# Push after the auto-commit on a correct answer
# AOC_PUSH=1

# Default language override
# AOC_LANG=
